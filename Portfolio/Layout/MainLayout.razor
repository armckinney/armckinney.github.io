@inherits LayoutComponentBase
@inject Portfolio.Services.LayoutState LayoutState
@inject IJSRuntime JS
@implements IDisposable

<div class="transition-colors">
    <Header />
    <main>
        @Body
    </main>
    <Footer />
</div>

@code {
    private string? _lastAppliedTheme;

    protected override void OnInitialized()
    {
        LayoutState.OnChange += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedTheme = await JS.InvokeAsync<string>("getTheme");
            _lastAppliedTheme = savedTheme;
            LayoutState.SetTheme(savedTheme);
            await JS.InvokeVoidAsync("setTheme", LayoutState.Theme);
        }
    }

    private void OnStateChanged()
    {
        if (_lastAppliedTheme != LayoutState.Theme)
        {
            _lastAppliedTheme = LayoutState.Theme;
            _ = JS.InvokeVoidAsync("setTheme", LayoutState.Theme);
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        LayoutState.OnChange -= OnStateChanged;
    }
}
