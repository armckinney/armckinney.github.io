@using Portfolio.Services
@using Portfolio.Models
@using Portfolio.Components.Common
@inject PortfolioService PortfolioService
@inject LayoutState LayoutState
@implements IDisposable

<section id="achievements" class="section">
    <div class="container">
        <div class="section-title-wrapper">
            <h2 class="section-title">Achievements</h2>
            <p class="section-subtitle">
                Proven track record of delivering results in high-stakes environments
            </p>
        </div>

        <!-- Filters -->
        @if (!MaxCount.HasValue)
        {
        <div class="filters-container">
            <!-- Search Filter -->
            <div>
                <label class="filter-group-label">Search</label>
                <div class="search-wrapper">
                    <input @bind="SearchQuery" @bind:event="oninput" type="text" placeholder="Search achievements..." class="filter-input" />
                    <Icon Name="search" Class="search-icon w-4 h-4" />
                </div>
            </div>

            <!-- Company Filter -->
            <div>
                <label class="filter-group-label">Company</label>
                <select @bind="ActiveCompany" class="filter-select">
                    @foreach (var company in Companies)
                    {
                        <option value="@company">@company</option>
                    }
                </select>
            </div>

            <!-- Domain Filter -->
            <div>
                <label class="filter-group-label">Domain</label>
                <select @bind="ActiveDomain" class="filter-select">
                    @foreach (var domain in Domains)
                    {
                        <option value="@domain">@domain</option>
                    }
                </select>
            </div>

            <!-- Principle Filter -->
            <div>
                <label class="filter-group-label">Leadership Principle</label>
                <select @bind="ActivePrinciple" class="filter-select">
                    @foreach (var p in Principles)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>

            <!-- Technology Filter -->
            <div>
                <label class="filter-group-label">Technology</label>
                <select @bind="ActiveTech" class="filter-select">
                    @foreach (var tech in Technologies)
                    {
                        <option value="@tech">@tech</option>
                    }
                </select>
            </div>
        </div>
        }

        <!-- Achievements Grid -->
        <div class="stories-grid">
            @foreach (var item in FilteredAchievements)
            {
                <div @onclick="() => SelectAchievement(item)" class="story-card group">
                    <div class="card-header">
                        <span class="domain-badge">
                            @item.Domains.FirstOrDefault()
                        </span>
                        @if (!string.IsNullOrEmpty(item.Timeframe))
                        {
                            <span class="timeframe-text">@item.Timeframe</span>
                        }
                    </div>

                    <h3 class="card-title">@item.Title</h3>

                    @if (!string.IsNullOrEmpty(item.Company))
                    {
                        <p class="card-meta">@item.Company</p>
                    }

                    <p class="card-result">@item.Result</p>

                    <div class="card-footer">
                        <div class="tech-tags">
                            @foreach (var tech in item.Technologies.Take(4))
                            {
                                <span class="tech-tag">@tech</span>
                            }
                            @if (item.Technologies.Count > 4)
                            {
                                <span class="tech-tag">+@(item.Technologies.Count - 4)</span>
                            }
                        </div>
                        <div class="arrow-icon-wrapper">
                            <Icon Name="arrow-right" Class="w-5 h-5" />
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!FilteredAchievements.Any())
        {
            <div class="no-results">
                <p>No achievements match the selected filters.</p>
            </div>
        }

        @if (MaxCount.HasValue && AchievementItems.Count > MaxCount.Value)
        {
            <div class="view-all-container">
                <button @onclick="NavigateToAllAchievements" class="btn btn-primary btn-padded">
                    View All Achievements
                </button>
            </div>
        }
    </div>

    <!-- Modal -->
    @if (SelectedAchievement != null)
    {
        <div class="modal-overlay" @onclick="CloseAchievement">
            <div class="modal-content" @onclick:stopPropagation>
                <div class="modal-inner">
                    <div class="modal-header">
                        <div class="modal-title-group">
                            <h3>@SelectedAchievement.Title</h3>
                            <p class="modal-meta">
                                @SelectedAchievement.Company
                                @if (!string.IsNullOrEmpty(SelectedAchievement.Role))
                                {
                                    <span class="meta-separator">•</span>
                                    <span>@SelectedAchievement.Role</span>
                                }
                                @if (!string.IsNullOrEmpty(SelectedAchievement.Timeframe))
                                {
                                    <span class="meta-separator">•</span>
                                    <span>@SelectedAchievement.Timeframe</span>
                                }
                            </p>
                            <div class="modal-tags">
                                @foreach (var d in SelectedAchievement.Domains)
                                {
                                    <span class="domain-badge">@d</span>
                                }
                                @foreach (var p in SelectedAchievement.Principles)
                                {
                                    <span class="principle-tag">@p</span>
                                }
                            </div>
                        </div>
                        <button @onclick="CloseAchievement" class="close-btn" aria-label="Close modal">
                            <Icon Name="x" Class="h-6 w-6" />
                        </button>
                    </div>

                    <div class="car-sections">
                        <!-- CAR Framework -->
                        <div class="car-box challenge-box">
                            <h4>Challenge / Context</h4>
                            <p>@SelectedAchievement.Challenge</p>
                        </div>
                        <div class="car-box neutral-box">
                            <h4>Action</h4>
                            <p>@SelectedAchievement.Action</p>
                        </div>
                        <div class="car-box result-box">
                            <h4>Result</h4>
                            <p>@SelectedAchievement.Result</p>
                        </div>

                        @if (SelectedAchievement.Technologies.Any())
                        {
                            <div class="modal-tech-section">
                                <h4>Technologies</h4>
                                <div class="tech-tags">
                                    @foreach (var tech in SelectedAchievement.Technologies)
                                    {
                                        <span class="tech-tag">@tech</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public int? MaxCount { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private List<AchievementModel> AchievementItems = new();
    private AchievementModel? SelectedAchievement => LayoutState.SelectedAchievement;
    private string ActiveCompany = "All";
    private string ActiveDomain = "All";
    private string ActivePrinciple = "All";
    private string ActiveTech = "All";
    private string SearchQuery = "";

    private IEnumerable<string> Companies => new[] { "All" }.Concat(
        AchievementItems.Select(s => s.Company).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct());
    private IEnumerable<string> Domains => new[] { "All" }.Concat(
        AchievementItems.SelectMany(s => s.Domains).Distinct().OrderBy(d => d));
    private IEnumerable<string> Principles => new[] { "All" }.Concat(
        AchievementItems.SelectMany(s => s.Principles).Distinct().OrderBy(p => p));
    private IEnumerable<string> Technologies => new[] { "All" }.Concat(
        AchievementItems.SelectMany(s => s.Technologies).Distinct().OrderBy(t => t));

    protected override async Task OnInitializedAsync()
    {
        AchievementItems = await PortfolioService.GetAchievementsAsync();
        LayoutState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
    }

    private void SelectAchievement(AchievementModel item)
    {
        LayoutState.SelectAchievement(item);
    }

    private void CloseAchievement()
    {
        LayoutState.SelectAchievement(null);
    }

    private void NavigateToAllAchievements()
    {
        NavigationManager.NavigateTo("achievements");
    }

    private IEnumerable<AchievementModel> FilteredAchievements
    {
        get
        {
            var query = AchievementItems.Where(s =>
                (string.IsNullOrWhiteSpace(SearchQuery) ||
                 s.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                 s.Company.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                 s.Role.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                 s.Challenge.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                 s.Action.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                 s.Result.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)) &&
                (ActiveCompany == "All" || s.Company == ActiveCompany) &&
                (ActiveDomain == "All" || s.Domains.Contains(ActiveDomain)) &&
                (ActivePrinciple == "All" || s.Principles.Contains(ActivePrinciple)) &&
                (ActiveTech == "All" || s.Technologies.Contains(ActiveTech))
            );

            if (MaxCount.HasValue)
            {
                return query.Where(p => p.Pin).Take(MaxCount.Value);
            }

            return query;
        }
    }
}
